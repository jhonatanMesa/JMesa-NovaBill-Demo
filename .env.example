# Run npm run setup to generate local-only random credentials.
DATABASE_URL=postgresql://novabill:replace_with_generated_password@127.0.0.1:5432/novabill_demo?schema=public
POSTGRES_USER=novabill
POSTGRES_PASSWORD=replace_with_generated_password
POSTGRES_DB=novabill_demo
JWT_SECRET=replace_with_generated_random_secret
APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
COOKIE_SECURE=false
